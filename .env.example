# Proveedor de LLM — decisión en docs/context/ale_dev/SPRINTS.md
# NUNCA commitear la key real: .env.local está en .gitignore
ANTHROPIC_API_KEY=sk-ant-...

# Niveles de modelo del runtime (lib/contracts/firmas.ts)
#   rapido -> Coordinador, Guardian, Detective
#   capaz  -> Auditor (solo casos pausados/escalados)
MODELO_RAPIDO=claude-haiku-5-5
MODELO_CAPAZ=claude-opus-5-5

# 1 = los agentes devuelven salidas fijas por escenario, sin gastar tokens.
# Es lo que permite el demo end-to-end del SYNC 1 (hora 9).
AGENTS_MOCK=1
